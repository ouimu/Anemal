{
  "compilerOptions": {
    "target":          "ES2020",
    "module":          "commonjs",
    "lib":             ["ES2020"],
    "outDir":          "./dist",
    "rootDir":         "./",
    "strict":          true,
    "esModuleInterop": true,
    "skipLibCheck":    true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots":       ["./node_modules/@types", "./types"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "dist", "__tests__"]
}
