// @db-agent reviewed — every tenant-scoped model has tenantId
// RULE: All queries must pass tenantId explicitly; never derive inside service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  subdomain String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users          User[]
  owners         Owner[]
  pets           Pet[]
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  invoices       Invoice[]
  invoiceItems   InvoiceItem[]
  vaccinations   Vaccination[]
  attachments    Attachment[]
  settings       TenantSettings?
  // Phase 4
  branches            Branch[]
  branchInventory     BranchInventory[]
  doctorShifts        DoctorShift[]
  hospitalizations    Hospitalization[]
  dailyInpatientCare  DailyInpatientCare[]
  groomingBookings    GroomingBooking[]
  bloodDonors         BloodDonor[]
  bloodDonations      BloodDonation[]
  bloodTransfusions   BloodTransfusion[]
  loyaltyTransactions LoyaltyTransaction[]
  auditLogs           AuditLog[]
  petReminders        PetReminder[]

  @@map("tenants")
}

// Clinic profile & configuration — one row per tenant
model TenantSettings {
  id                  Int      @id @default(autoincrement())
  tenantId            Int      @unique
  logoUrl             String?
  phone               String?  @db.VarChar(50)
  email               String?  @db.VarChar(255)
  website             String?  @db.VarChar(255)
  address             String?
  taxId               String?  @db.VarChar(50)
  // Appointment defaults
  defaultSlotMinutes  Int      @default(30)
  workStartTime       String   @default("08:00") @db.VarChar(5)
  workEndTime         String   @default("18:00") @db.VarChar(5)
  // Notification toggles
  smsRemindersEnabled  Boolean @default(true)
  lineRemindersEnabled Boolean @default(true)
  // Subscription
  planTier            String   @default("starter") @db.VarChar(50)
  // Phase 1.5 — operating hours per day: { mon:{open:"08:00",close:"18:00"}, sun:null, ... }
  operatingHours      Json?
  // Phase 1.5 — LINE OA (token AES-256-GCM encrypted, enc:v1 format)
  lineOaToken         String?
  // Phase 1.5 — SMS ('thaibulksms' | 'thsms' | null; apiKey encrypted)
  smsProvider         String?  @db.VarChar(50)
  smsApiKey           String?
  smsSenderName       String?  @db.VarChar(100)
  // Phase 1.5 — Payments (gbprimepaySecret encrypted)
  promptpayId         String?  @db.VarChar(50)
  paymentQrUrl        String?
  gbprimepayPublic    String?  @db.VarChar(255)
  gbprimepaySecret    String?
  // Phase 1.5 — Lab integration (labApiKey encrypted)
  labApiUrl           String?  @db.VarChar(500)
  labApiKey           String?
  updatedBy           Int?
  updatedAt           DateTime @updatedAt

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedByUser User?  @relation("TenantSettingsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("tenant_settings")
}

model User {
  id               Int      @id @default(autoincrement())
  tenantId         Int
  branchId         Int?     // primary branch (Phase 4)
  name             String   @db.VarChar(255)
  email            String   @db.VarChar(255)
  passwordHash     String   @db.VarChar(255)
  role             Role
  isActive         Boolean  @default(true)
  allowedStartTime String?  @db.VarChar(5) // "HH:MM" login window start (Phase 4)
  allowedEndTime   String?  @db.VarChar(5) // "HH:MM" login window end
  language            String @default("th")   @db.VarChar(5)  // personal preference (Phase 1.5-B)
  defaultCalendarView String @default("week") @db.VarChar(10) // day | week | month
  lastLoginAt      DateTime?
  createdAt        DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  medicalRecords MedicalRecord[]
  // Phase 1.5 settings back-relations
  tenantSettingsUpdated TenantSettings[]   @relation("TenantSettingsUpdatedBy")
  systemSettingsUpdated SystemSettings[]   @relation("SystemSettingsUpdatedBy")
  settingsAuditChanges  SettingsAuditLog[] @relation("SettingsAuditChangedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, branchId])
  @@map("users")
}

enum Role {
  admin
  doctor
  staff
  superadmin // platform operator — system_settings access only (Phase 1.5-B)
}

// Platform-global settings — NOT tenant-scoped; super-admin only (Phase 1.5)
model SystemSettings {
  key           String   @id @db.VarChar(100)
  value         String
  description   String?  @db.VarChar(500)
  category      String   @default("platform") @db.VarChar(50) // 'smtp' | 'platform' | 'feature_flags'
  isSecret      Boolean  @default(false)
  updatedBy     Int?
  updatedAt     DateTime @updatedAt

  updatedByUser User? @relation("SystemSettingsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([category])
  @@map("system_settings")
}

// Field-level settings change trail (Phase 1.5).
// tenantId NULL = system_settings change. No tenant FK — audit rows survive tenant deletion.
model SettingsAuditLog {
  id            Int      @id @default(autoincrement())
  tenantId      Int?
  changedBy     Int?
  tableName     String   @db.VarChar(100) // 'tenant_settings' | 'system_settings'
  fieldName     String   @db.VarChar(100)
  oldValue      String?  // masked if secret
  newValue      String?  // masked if secret
  changedAt     DateTime @default(now())

  changedByUser User? @relation("SettingsAuditChangedBy", fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, changedAt])
  @@index([tableName, fieldName, changedAt])
  @@map("settings_audit_log")
}

model Owner {
  id             Int      @id @default(autoincrement())
  tenantId       Int
  firstName      String   @db.VarChar(100)
  lastName       String   @db.VarChar(100)
  phone          String   @db.VarChar(50)
  email          String?  @db.VarChar(255)
  lineId         String?  @db.VarChar(100)
  address        String?
  isActive       Boolean  @default(true)   // Phase 4 soft-deactivation
  loyaltyPoints  Int      @default(0)       // Phase 4 loyalty balance
  membershipTier String   @default("standard") @db.VarChar(50) // standard|silver|gold|platinum
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pets   Pet[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@map("owners")
}

model Pet {
  id                   Int       @id @default(autoincrement())
  tenantId             Int
  ownerId              Int
  name                 String    @db.VarChar(100)
  species              String    @db.VarChar(50)
  breed                String?   @db.VarChar(100)
  color                String?   @db.VarChar(100)
  birthDate            DateTime? @db.Date
  gender               Gender?
  weightKg             Decimal?  @db.Decimal(5, 2)
  microchipId          String?   @db.VarChar(50)
  photoUrl             String?
  allergies            String?
  underlyingConditions String?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner          Owner           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  vaccinations   Vaccination[]
  invoices       Invoice[]
  // Phase 4
  hospitalizations  Hospitalization[]
  groomingBookings  GroomingBooking[]
  bloodDonors       BloodDonor[]
  bloodTransfusions BloodTransfusion[]
  petReminders      PetReminder[]

  @@index([tenantId])
  @@index([tenantId, ownerId])
  @@index([tenantId, microchipId])
  @@index([tenantId, name])
  @@map("pets")
}

enum Gender {
  male
  female
  unknown
}

model Appointment {
  id          Int               @id @default(autoincrement())
  tenantId    Int
  branchId    Int?
  petId       Int
  doctorId    Int
  room        String?           @db.VarChar(50)
  scheduledAt DateTime
  durationMin Int               @default(30)
  reason      String?
  status      AppointmentStatus @default(scheduled)
  notes       String?
  createdAt   DateTime          @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pet            Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)
  doctor         User            @relation(fields: [doctorId], references: [id])
  medicalRecords MedicalRecord[]

  @@index([tenantId])
  @@index([tenantId, doctorId, scheduledAt])
  @@index([tenantId, petId])
  @@map("appointments")
}

enum AppointmentStatus {
  scheduled
  arrived
  in_progress
  completed
  cancelled
  no_show
}

model MedicalRecord {
  id                Int      @id @default(autoincrement())
  tenantId          Int
  branchId          Int?
  petId             Int
  appointmentId     Int?
  doctorId          Int
  subjective        String?
  objective         String?
  assessment        String?
  plan              String?
  weightKg          Decimal? @db.Decimal(5, 2)
  temperatureC      Decimal? @db.Decimal(4, 1)
  heartRateBpm      Int?
  respRateRpm       Int?
  anatomyAnnotation Json?
  createdAt         DateTime @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pet           Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  doctor        User          @relation(fields: [doctorId], references: [id])
  prescriptions Prescription[]
  attachments   Attachment[]
  invoices      Invoice[]

  @@index([tenantId])
  @@index([tenantId, petId])
  @@map("medical_records")
}

model Prescription {
  id               Int      @id @default(autoincrement())
  tenantId         Int
  medicalRecordId  Int
  drugId           Int
  quantity         Decimal  @db.Decimal(8, 2)
  unit             String?  @db.VarChar(50)
  dosageInstruction String?
  createdAt        DateTime @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  drug          InventoryItem @relation(fields: [drugId], references: [id])

  @@index([tenantId])
  @@index([tenantId, medicalRecordId])
  @@map("prescriptions")
}

// Product catalog (Phase 4: stock moved to BranchInventory — this is now definition-only).
model InventoryItem {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  name          String   @db.VarChar(255)
  category      String?  @db.VarChar(100)
  barcode       String?  @db.VarChar(100)
  unit          String?  @db.VarChar(50)
  unitCost      Decimal? @db.Decimal(10, 2)
  unitPrice     Decimal? @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prescriptions   Prescription[]
  stockMovements  StockMovement[]
  branchInventory BranchInventory[]

  @@index([tenantId])
  @@index([tenantId, barcode])
  @@map("inventory_items")
}

// Per-branch stock — the source of truth (Phase 4, FR-06-02).
model BranchInventory {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  branchId    Int
  productId   Int
  stockQty    Decimal   @default(0) @db.Decimal(10, 2)
  minStockQty Decimal   @default(0) @db.Decimal(10, 2)
  lotNo       String?   @db.VarChar(100)
  expiryDate  DateTime? @db.Date
  updatedAt   DateTime  @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch  Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product InventoryItem @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, productId])
  @@index([tenantId, branchId, productId])
  @@map("branch_inventory")
}

// Stock card / ledger — per-branch movement history (FR-06-04); transfers use destinationBranchId.
model StockMovement {
  id                  Int      @id @default(autoincrement())
  tenantId            Int
  branchId            Int?
  itemId              Int
  movementType        String   @db.VarChar(20) // in|out|adjustment|transfer_in|transfer_out
  qty                 Decimal  @db.Decimal(10, 2)
  referenceType       String?  @db.VarChar(50) // prescription|retail|manual|transfer
  referenceId         Int?
  destinationBranchId Int?
  notes               String?
  performedBy         Int?
  createdAt           DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId, itemId, createdAt])
  @@index([tenantId, branchId, itemId, createdAt])
  @@map("stock_movements")
}

model Invoice {
  id              Int            @id @default(autoincrement())
  tenantId        Int
  branchId        Int?
  petId           Int?
  medicalRecordId Int?
  invoiceNo       String         @db.VarChar(100)
  issuedAt        DateTime       @default(now())
  subtotal        Decimal        @default(0) @db.Decimal(10, 2)
  discount        Decimal        @default(0) @db.Decimal(10, 2)
  discountReason  String?
  taxRate         Decimal        @default(7) @db.Decimal(5, 2)
  taxAmount       Decimal        @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal        @db.Decimal(10, 2)
  paymentStatus   PaymentStatus  @default(pending)
  paymentMethod   String?        @db.VarChar(50)
  paidAt          DateTime?
  notes           String?
  createdBy       Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pet           Pet?           @relation(fields: [petId], references: [id])
  medicalRecord MedicalRecord? @relation(fields: [medicalRecordId], references: [id])
  items         InvoiceItem[]

  @@unique([tenantId, invoiceNo])
  @@index([tenantId, petId])
  @@index([tenantId, issuedAt])
  @@map("invoices")
}

enum PaymentStatus {
  pending
  paid
  partial
  void
  refunded
}

model InvoiceItem {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  invoiceId   Int
  description String   @db.VarChar(255)
  quantity    Decimal  @db.Decimal(8, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  itemType    String?  @db.VarChar(50)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@map("invoice_items")
}

model Vaccination {
  id             Int       @id @default(autoincrement())
  tenantId       Int
  petId          Int
  vaccineName    String    @db.VarChar(100)
  administeredAt DateTime  @db.Date
  nextDueAt      DateTime? @db.Date
  batchNo        String?   @db.VarChar(50)
  notes          String?
  createdAt      DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pet    Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([tenantId, petId])
  @@index([tenantId, nextDueAt])
  @@map("vaccinations")
}

model Attachment {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  medicalRecordId Int
  fileName        String   @db.VarChar(255)
  fileUrl         String
  fileType        String?  @db.VarChar(50)
  createdAt       DateTime @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  @@index([tenantId, medicalRecordId])
  @@map("attachments")
}

// ─── Phase 4: Multi-branch ───────────────────────────────────────────────────
model Branch {
  id             Int      @id @default(autoincrement())
  tenantId       Int
  name           String   @db.VarChar(255)
  phone          String?  @db.VarChar(50)
  email          String?  @db.VarChar(255)
  address        String?
  operatingHours Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users           User[]
  branchInventory BranchInventory[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("branches")
}

model DoctorShift {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  branchId  Int
  doctorId  Int
  dayOfWeek Int      // 0=Sun … 6=Sat
  startTime String   @db.VarChar(5) // "HH:MM"
  endTime   String   @db.VarChar(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, doctorId, dayOfWeek])
  @@index([tenantId, branchId, doctorId])
  @@map("doctor_shifts")
}

// ─── Phase 4: Inpatient / Hospitalization ────────────────────────────────────
model Hospitalization {
  id             Int       @id @default(autoincrement())
  tenantId       Int
  branchId       Int?
  petId          Int
  admittedAt     DateTime  @default(now())
  dischargedAt   DateTime?
  reason         String
  cageNo         String?   @db.VarChar(50)
  status         String    @default("admitted") @db.VarChar(20) // admitted|discharged|transferred
  doctorInCharge Int?
  dailyRate      Decimal   @default(0) @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pet      Pet                  @relation(fields: [petId], references: [id], onDelete: Cascade)
  careLogs DailyInpatientCare[]

  @@index([tenantId, petId, status])
  @@index([tenantId, branchId, status])
  @@map("hospitalizations")
}

model DailyInpatientCare {
  id                 Int      @id @default(autoincrement())
  tenantId           Int
  hospitalizationId  Int
  recordedAt         DateTime @default(now())
  timeSlot           String   @db.VarChar(20) // 08:00|12:00|16:00|20:00
  temperatureC       Decimal? @db.Decimal(4, 1)
  heartRateBpm       Int?
  respRateRpm        Int?
  feedingStatus      String?  @db.VarChar(255)
  medicationGiven    String?
  notes              String?
  performedBy        Int?

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hospitalization Hospitalization @relation(fields: [hospitalizationId], references: [id], onDelete: Cascade)

  @@index([tenantId, hospitalizationId, recordedAt])
  @@map("daily_inpatient_care")
}

// ─── Phase 4: Grooming ───────────────────────────────────────────────────────
model GroomingBooking {
  id                  Int      @id @default(autoincrement())
  tenantId            Int
  branchId            Int?
  petId               Int
  groomerId           Int?
  serviceType         String   @db.VarChar(255)
  scheduledAt         DateTime
  durationMin         Int      @default(60)
  status              String   @default("scheduled") @db.VarChar(20) // scheduled|in_progress|completed|cancelled
  specialInstructions String?
  notes               String?
  createdBy           Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pet    Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, scheduledAt])
  @@index([tenantId, groomerId, scheduledAt])
  @@map("grooming_bookings")
}

// ─── Phase 4: Blood Bank ─────────────────────────────────────────────────────
model BloodDonor {
  id             Int       @id @default(autoincrement())
  tenantId       Int
  petId          Int
  bloodType      String    @db.VarChar(50)
  lastDonationAt DateTime?
  isEligible     Boolean   @default(true)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pet       Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)
  donations BloodDonation[]

  @@unique([tenantId, petId])
  @@index([tenantId, bloodType])
  @@map("blood_donors")
}

model BloodDonation {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  donorId     Int
  volumeMl    Decimal   @db.Decimal(10, 2)
  collectedAt DateTime  @default(now())
  collectedBy Int?
  expiryDate  DateTime  @db.Date
  status      String    @default("available") @db.VarChar(20) // available|used|expired|discarded
  notes       String?

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  donor  BloodDonor @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, expiryDate])
  @@map("blood_donations")
}

model BloodTransfusion {
  id             Int      @id @default(autoincrement())
  tenantId       Int
  recipientPetId Int
  donationId     Int?
  volumeMl       Decimal  @db.Decimal(10, 2)
  administeredAt DateTime @default(now())
  administeredBy Int?
  reactions      String?
  notes          String?

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipientPet Pet    @relation(fields: [recipientPetId], references: [id], onDelete: Cascade)

  @@index([tenantId, recipientPetId])
  @@map("blood_transfusions")
}

// ─── Phase 4: Loyalty ────────────────────────────────────────────────────────
model LoyaltyTransaction {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  ownerId         Int
  invoiceId       Int?
  pointsEarned    Int      @default(0)
  pointsRedeemed  Int      @default(0)
  transactionType String   @db.VarChar(20) // earn|redeem|adjustment
  notes           String?
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner  Owner  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([tenantId, ownerId])
  @@map("loyalty_transactions")
}

// ─── Phase 4: Audit (write-once) ─────────────────────────────────────────────
model AuditLog {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  userId     Int?
  action     String   @db.VarChar(255)
  tableName  String?  @db.VarChar(100)
  recordId   Int?
  details    Json?
  ipAddress  String?  @db.VarChar(50)
  userAgent  String?  @db.VarChar(500)
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ─── Phase 4: Proactive reminders ────────────────────────────────────────────
model PetReminder {
  id           Int       @id @default(autoincrement())
  tenantId     Int
  petId        Int
  reminderType String    @db.VarChar(100) // vaccination|deworming|health_checkup
  message      String
  dueDate      DateTime  @db.Date
  status       String    @default("pending") @db.VarChar(20) // pending|sent|completed|cancelled
  sentAt       DateTime?
  channel      String    @default("line") @db.VarChar(20) // line|sms|email|all
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pet    Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([tenantId, dueDate, status])
  @@index([tenantId, petId])
  @@map("pet_reminders")
}
