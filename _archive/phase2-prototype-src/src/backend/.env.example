# Environment Variables — VetCare SaaS Backend
# Copy this file to .env and fill in real values
# NEVER commit .env to version control

# ── Application ──────────────────────
NODE_ENV=development
PORT=4000
API_VERSION=v1

# ── Database ─────────────────────────
DATABASE_URL="postgresql://vetcare_user:your_password@localhost:5432/vetcare_dev?schema=public"

# ── Authentication ────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_ACCESS_EXPIRES=8h
JWT_REFRESH_EXPIRES=30d

# ── File Storage (AWS S3 / Cloudflare R2) ────
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=vetcare-uploads

# ── LINE Messaging API ────────────────
LINE_CHANNEL_ACCESS_TOKEN=your_line_token
LINE_CHANNEL_SECRET=your_line_secret

# ── Email (SendGrid) ─────────────────
SENDGRID_API_KEY=your_sendgrid_key
EMAIL_FROM=noreply@vetcare.app

# ── Payment Gateway ──────────────────
OMISE_PUBLIC_KEY=pkey_...
OMISE_SECRET_KEY=skey_...

# ── CORS ─────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://app.vetcare.app

# ── Rate Limiting ─────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
