{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "src/frontend/dist",
  "installCommand": "npm install",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(auth|users|admin|clinic|platform|api)/(.*)", "destination": "/api" },
    { "source": "/((?!auth|users|admin|clinic|platform|api|assets).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/reminders", "schedule": "0 9 * * *" }
  ]
}
