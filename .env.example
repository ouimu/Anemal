# Copy this to .env and fill in values — never commit .env

PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/vetclinic_dev
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
NODE_ENV=development

# File storage (S3 or GCS)
STORAGE_BUCKET=
STORAGE_REGION=

# SMS/LINE reminder integration
LINE_CHANNEL_TOKEN=
SMS_API_KEY=

# Claude Code CLI — MCP servers
GITHUB_TOKEN=ghp_your_personal_access_token_here

# AES-256-GCM key for settings secrets - generate with: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=

# Shared secret for Vercel Cron -> /api/cron/* routes (Authorization: Bearer <value>)
# Required — the app refuses to start without it. Generate with: openssl rand -hex 32
CRON_SECRET=

# Feature flag: enable the reminder dispatch loop (worker + cron). Default OFF —
# no real LINE/SMS/email provider integration exists yet; leaving this on marks
# reminders "sent" without ever delivering them. See R2-HI-04.
REMINDER_DISPATCH_ENABLED=false
