{
  "env": {
    "NODE_ENV": "development",
    "PORT": "4000",
    "FRONTEND_URL": "http://localhost:5173"
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "mcp__postgres__*",
      "mcp__github__*",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(ts-node *)",
      "Bash(prisma *)",
      "Bash(git *)",
      "Bash(curl *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(echo *)",
      "Bash(cd *)",
      "Bash(pwd)",
      "Bash(docker *)",
      "Bash(psql *)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false
  }
}